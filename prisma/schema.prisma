generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection (Supavisor 6543 in prod)
  directUrl = env("DIRECT_URL")     // direct connection, used for migrations
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  projects      Project[]

  // Dodo Payments fields
  dodoCustomerId         String?  @unique
  dodoSubscriptionId     String?  @unique
  dodoProductId          String?
  dodoPlanCadence        String?  // 'monthly' | 'annual' | 'lifetime'
  dodoSubscriptionStatus String?  // 'active' | 'on_hold' | 'cancelled' | 'failed' | 'expired'
  dodoCancelAtPeriodEnd  Boolean?  // true when a cancellation is scheduled for period end
  dodoCurrentPeriodEnd   DateTime? // end of the paid period (next billing date, or expiry when cancelling)
}

model Project {
  id        String     @id @default(cuid())
  name      String
  domain    String?
  widgetKey String     @unique @default(cuid())
  settings  Json       @default("{}")
  widgetLastSeenAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks       Feedback[]
  intentResponses IntentResponse[]

  @@index([userId])
}

model Feedback {
  id        String   @id @default(cuid())
  message   String   @db.Text
  category  String   @default("general")
  sentiment String?
  userEmail String?
  pageUrl   String?
  userAgent String?
  metadata  Json     @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model IntentResponse {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId   String
  eventName   String
  optionId    String?
  optionLabel String?
  text        String?  @db.Text
  context     Json     @default("{}")
  country     String?
  pageUrl     String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
